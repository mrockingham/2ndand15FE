VITE_API_BASE_URL=http://localhost:3000/api/v1

# Canonical production origin. Set the real value in the Vercel Production
# environment to generate canonicals, robots.txt's sitemap entry, and sitemap.xml.
# VITE_SITE_URL=https://www.example.com

# Public GA4 web-stream measurement ID. Analytics remains disabled when this
# is missing or invalid and only loads in production after visitor consent.
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Set to "false" to hide the Forgot Password form and show an "unavailable"
# notice instead. Use this in production until Resend email delivery is
# confirmed working end-to-end (see docs/auth-contract.md).
# VITE_PASSWORD_RECOVERY_ENABLED=false
